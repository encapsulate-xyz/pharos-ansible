[Unit]
Description={{ service_identifier }}

[Service]
User={{ service_identifier }}
Group={{ service_identifier }}
WorkingDirectory={{ node_bin_dir }}
EnvironmentFile={{ node_environment_general_file_path }}
ExecStart={{ node_bin_dir }}/{{ service_identifier }} -c {{ node_launch_conf_file_path }}
Restart=always
RestartSec=4
LimitNOFILE=65536
MemoryMax=512G

[Install]
WantedBy=multi-user.target
